+    /// Getter for `num_gpu_blocks`
+    pub fn num_gpu_blocks(&self) -> Option<usize> {
+        self.num_gpu_blocks
+    }
+
+    /// Getter for `num_cpu_blocks`
+    pub fn num_cpu_blocks(&self) -> Option<usize> {
+        self.num_cpu_blocks
+    }
+}
