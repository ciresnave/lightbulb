-            // already [B, H * W, C]
-            hidden_states
-        };
-        // standard self-attention
-        let key = self
-            .transpose_for_scores(self.key.forward(&hidden_states)?)?
-            .contiguous()?;
-        let value = self
-            .transpose_for_scores(self.value.forward(&hidden_states)?)?
