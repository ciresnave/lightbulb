-
-        Ok(Self {
-            embedding,
-            encoder,
-            output_layer,
-        })
-    }
-
-    pub fn reset_kv_cache(&mut self) {
-        self.encoder.reset_kv_cache()
-    }
-
-    pub fn forward(&mut self, xs: &Tensor) -> Result<Tensor> {
