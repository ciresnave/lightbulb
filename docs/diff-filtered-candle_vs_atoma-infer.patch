-    let rb = &chunks[1];
-    let x1y1 = anchor_points.sub(lt)?;
-    let x2y2 = anchor_points.add(rb)?;
-    let c_xy = ((&x1y1 + &x2y2)? * 0.5)?;
-    let wh = (&x2y2 - &x1y1)?;
-    Tensor::cat(&[c_xy, wh], 1)
-}
