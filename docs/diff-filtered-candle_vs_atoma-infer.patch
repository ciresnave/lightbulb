-async fn fetch_url(url: &str) -> Result<Vec<u8>, JsValue> {
-    use web_sys::{Request, RequestCache, RequestInit, RequestMode, Response};
-    let window = web_sys::window().ok_or("window")?;
-    let opts = RequestInit::new();
-    opts.set_method("GET");
