-    let data = JsFuture::from(resp.blob()?).await?;
-    let blob = web_sys::Blob::from(data);
-    let array_buffer = JsFuture::from(blob.array_buffer()).await?;
-    let data = js_sys::Uint8Array::new(&array_buffer).to_vec();
-    Ok(data)
-}
