-        let position_ids =
-            Tensor::arange(0, cfg.max_position_embeddings as u32, vb.device())?.unsqueeze(0)?;
-        Ok(Self {
-            word_embeddings,
-            position_embeddings,
-            layer_norm,
-            position_ids,
-        })
-    }
-
-    fn forward(&self, xs: &Tensor, past_kv_len: usize) -> Result<Tensor> {
-        let seq_len = xs.dim(1)?;
