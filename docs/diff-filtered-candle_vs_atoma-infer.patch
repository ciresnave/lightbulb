-// anymore.
-pub fn simple_eval(
-    model: &onnx::ModelProto,
-    mut inputs: HashMap<String, Value>,
-) -> Result<HashMap<String, Value>> {
-    let graph = match &model.graph {
-        None => bail!("no graph defined in proto"),
