-    fn fmt_dt<T: WithDType + std::fmt::Display>(
-        &self,
-        f: &mut std::fmt::Formatter,
-    ) -> std::fmt::Result {
-        let device_str = match self.device().location() {
-            crate::DeviceLocation::Cpu => "".to_owned(),
-            crate::DeviceLocation::Cuda { gpu_id } => {
-                format!(", cuda:{gpu_id}")
-            }
-            crate::DeviceLocation::Metal { gpu_id } => {
-                format!(", metal:{gpu_id}")
-            }
