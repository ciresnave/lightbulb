-
-    let language_token_ids = LANGUAGES
-        .iter()
-        .map(|(t, _)| token_id(tokenizer, &format!("<|{t}|>")))
-        .map(|e| e.map_err(E::msg))
-        .collect::<Result<Vec<_>, E>>()?;
