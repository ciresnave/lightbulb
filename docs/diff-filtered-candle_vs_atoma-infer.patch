-        let hyper_in = Tensor::stack(hyper_in_list.as_slice(), 1)?.contiguous()?;
-        let (b, c, h, w) = upscaled_embedding.dims4()?;
-        let masks = hyper_in.matmul(&upscaled_embedding.reshape((b, c, h * w))?)?;
-        let masks = masks.reshape((b, (), h, w))?;
