-        #pragma clang loop unroll(full)
-        for (ushort s = BLOCKSIZE / 2; s >= 64; s >>= 1) {
-            if (tid < s) shared[tid] = operate(shared[tid], shared[tid + s]);
-            threadgroup_barrier(mem_flags::mem_none);
