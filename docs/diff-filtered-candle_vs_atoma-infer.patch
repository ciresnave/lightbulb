-            blocks: [3, 3, 9, 3],
-            channels: [96, 192, 384, 768],
-            use_conv_mlp: false,
-        }
-    }
-
-    pub fn small() -> Self {
-        Self {
-            blocks: [3, 3, 27, 3],
-            channels: [96, 192, 384, 768],
-            use_conv_mlp: false,
-        }
-    }
-
-    pub fn base() -> Self {
-        Self {
-            blocks: [3, 3, 27, 3],
-            channels: [128, 256, 512, 1024],
-            use_conv_mlp: false,
-        }
-    }
-
-    pub fn large() -> Self {
