-      // Do epilogue
-      if (use_out_source) {
-        if (do_axpby) {
-          mma_op.apply_epilogue_safe(
-              C,
-              addmm_params->ldc,
-              addmm_params->fdc,
-              short2(tgp_bn, tgp_bm),
