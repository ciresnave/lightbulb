-impl Module for NormConvTranspose1d {
-    fn forward(&self, xs: &Tensor) -> Result<Tensor> {
-        let _enter = self.span.enter();
-        // conv-transpose1d seems to be broken on metal after enough iterations. Causing
-        // the following error:
