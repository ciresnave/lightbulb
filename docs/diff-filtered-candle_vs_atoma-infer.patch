-    let bsz = mask.dim(0)?;
-    let src_len = mask.dim(1)?;
-    let tgt_len = tgt_len.unwrap_or(src_len);
-
-    let expanded_mask = mask
-        .unsqueeze(1)?
-        .unsqueeze(2)?
-        .expand((bsz, 1, tgt_len, src_len))?
-        .to_dtype(dtype)?;
-
-    let inverted_mask = (1.0 - expanded_mask)?;
-
-    (inverted_mask * get_dtype_min_val(dtype))?.to_dtype(dtype)
-}
