+            slot_mapping: Tensor::arange(0, tokens.len() as i64, &device)?,
+            decoding_metadata: None,
+            num_prefill_tokens: tokens.len(),
+            num_decoding_tokens: 0,
+            prefill_metadata: Some(FlashAttentionPrefillMetadata {
