-                let name = file.name();
-                name.strip_suffix(NPY_SUFFIX).unwrap_or(name).to_owned()
-            };
-            index_per_name.insert(name, i);
-        }
-        Ok(Self {
-            index_per_name,
-            path,
-        })
-    }
