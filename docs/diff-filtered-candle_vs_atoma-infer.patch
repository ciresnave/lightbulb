+    #[error("Invalid cache dtype: `{0}`")]
+    InvalidCacheDtype(String),
+    #[error("Invalid swap space fraction: `{0}`")]
+    InvalidSwapSpaceFraction(f32),
+    #[error("Invalid swap space: `{0}`")]
