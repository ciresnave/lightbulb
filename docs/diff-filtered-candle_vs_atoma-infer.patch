-pub trait Task: Module + Sized {
-    fn load(vb: VarBuilder, multiples: Multiples) -> Result<Self>;
-    fn report(
-        pred: &Tensor,
-        img: DynamicImage,
-        w: usize,
-        h: usize,
-        confidence_threshold: f32,
-        nms_threshold: f32,
-        legend_size: u32,
-    ) -> Result<DynamicImage>;
-}
