-/// The EulerAncestral Discrete scheduler.
-#[derive(Debug, Clone)]
-pub struct EulerAncestralDiscreteScheduler {
-    timesteps: Vec<usize>,
-    sigmas: Vec<f64>,
-    init_noise_sigma: f64,
