-            self.conv1.forward(&input_features)?
-        };
-
-        // Apply GELU activation after conv1 (matches Python: conv1 -> GELU)
-        let x = x.gelu()?;
-
-        // Apply conv2 (matches Python: conv2)
-        let x = if false {
