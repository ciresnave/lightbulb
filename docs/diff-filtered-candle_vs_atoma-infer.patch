-//! Variable initialization.
-// This is based on:
-// https://github.com/pytorch/pytorch/blob/07107919297db3f8ab37f11c12666b6d6d5f692e/torch/nn/init.py#
-use candle::{DType, Device, Result, Shape, Tensor, Var};
