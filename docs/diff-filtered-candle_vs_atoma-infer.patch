-impl Attention {
-    fn new(
-        dim: usize,
-        num_heads: usize,
-        qkv_bias: bool,
-        use_rel_pos: bool,
-        input_size: (usize, usize),
-        vb: VarBuilder,
-    ) -> Result<Self> {
