-    weightsURL,
-    modelID,
-    tokenizerURL,
-    quantized,
-    imageURL,
-    prompt,
-    seed,
-    temp,
-    top_p,
-    repeatPenalty,
-    maxSeqLen,
-    verbose_prompt,
-  } = data;
