-        let (wk, bk) = fuse_conv_bn(conv.weight(), bn)?;
-        w = (w + wk)?;
-        b = (b + bk)?;
-    };
-
-    let conv_scale_bn = batch_norm(dim, 1e-5, vb.pp("conv_scale.bn"));
-    let conv_scale = conv2d_no_bias(
-        in_channels,
-        out_channels,
-        1,
-        conv2d_cfg,
-        vb.pp("conv_scale.conv"),
