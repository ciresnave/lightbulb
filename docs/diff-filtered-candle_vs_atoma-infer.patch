-            vb.dtype(),
-            config,
-            config.local_rope_theta,
-            vb.device(),
-        )?);
-
-        let mut layers = Vec::with_capacity(config.num_hidden_layers);
-        for layer_id in 0..config.num_hidden_layers {
-            let layer_uses_local_attention = layer_id % config.global_attn_every_n_layers != 0;
