-    const data = await cachedResponse.arrayBuffer();
-    return new Uint8Array(data);
-  }
-  const res = await fetch(url, { cache: "force-cache" });
-  cache.put(url, res.clone());
-  return new Uint8Array(await res.arrayBuffer());
-}
