-impl ModelWeights {
-    pub fn from_gguf<R: std::io::Seek + std::io::Read>(
-        use_flash_attn: bool,
-        ct: gguf_file::Content,
-        reader: &mut R,
-        device: &Device,
-    ) -> Result<Self> {
