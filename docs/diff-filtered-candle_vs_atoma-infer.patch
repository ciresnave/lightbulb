-impl Module for StreamableConv1d {
-    fn forward(&self, xs: &Tensor) -> Result<Tensor> {
-        let _enter = self.span.enter();
-        let (_b, _t, _c) = xs.dims3()?;
-        let k_size = self.conv.conv.weight().dim(D::Minus1)?;
-        let conv_cfg = self.conv.conv.config();
