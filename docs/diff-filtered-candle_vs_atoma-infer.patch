-// Contains the intermediate results for the online softmax calculation.
-// m: max
-// d: sum of the exponentials
-template <typename T>
-struct MD {
-    T m;
-    float d;
-
-    constexpr MD<T>() = default;
-    constexpr MD<T>() threadgroup = default;
-};
