+        let _enter = self.span.enter();
+        trace!("Updating number of computed tokens");
+        for sequence in self.sequences.values() {
+            let is_finished = { sequence.read_lock()?.is_finished() };
+            if !is_finished {
+                {
+                    sequence
+                        .write_lock()?
+                        .sequence_data
+                        .update_num_computed_tokens(num_new_computed_tokens)?;
+                }
+            }
+        }
