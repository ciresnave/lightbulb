-    let shape = shape.into();
-    let mut data_t = vec![0f32; shape.elem_count()];
-    r.read_f32_into::<LittleEndian>(&mut data_t)?;
-    let tensor = Tensor::from_vec(data_t, shape, dev)?;
-    Ok(tensor)
