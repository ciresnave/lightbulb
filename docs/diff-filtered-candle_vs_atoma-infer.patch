-    fn forward(&self, xs: &Tensor) -> Result<Tensor> {
-        let batch_size = xs.dim(0)?;
-        let probe = self.probe.repeat((batch_size, 1, 1))?;
-        let xs = self.attention.forward(&probe, xs, xs)?;
-        let residual = &xs;
