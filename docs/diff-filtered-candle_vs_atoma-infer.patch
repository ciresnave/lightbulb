-pub fn sd3_vae_vb_rename(name: &str) -> String {
-    let parts: Vec<&str> = name.split('.').collect();
-    let mut result = Vec::new();
-    let mut i = 0;
-
-    while i < parts.len() {
-        match parts[i] {
-            "down_blocks" => {
-                result.push("down");
-            }
-            "mid_block" => {
-                result.push("mid");
-            }
-            "up_blocks" => {
-                result.push("up");
-                match parts[i + 1] {
-                    // Reverse the order of up_blocks.
-                    "0" => result.push("3"),
-                    "1" => result.push("2"),
-                    "2" => result.push("1"),
-                    "3" => result.push("0"),
