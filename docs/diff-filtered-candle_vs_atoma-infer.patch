-            None => xs,
-            Some(bias) => {
-                let b = bias.dims1()?;
-                let bias = bias.reshape((1, b, 1))?;
-                xs.broadcast_add(&bias)?
-            }
-        };
-        match self.norm.as_ref() {
-            None => Ok(xs),
-            Some(norm) => xs.apply(norm),
