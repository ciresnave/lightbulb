-        .iter()
-        .copied()
-        .flatten()
-        .copied()
-        .collect::<Vec<_>>();
-    let labels = Tensor::from_vec(labels, SAMPLES_PER_FILE, &Device::Cpu)?;
-    let images = Tensor::from_vec(images, (SAMPLES_PER_FILE, C, H, W), &Device::Cpu)?;
