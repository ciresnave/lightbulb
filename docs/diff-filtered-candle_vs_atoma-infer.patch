-struct CropBox {
-    x0: usize,
-    y0: usize,
-    x1: usize,
-    y1: usize,
-    layer_idx: usize,
-}
-
-impl CropBox {
-    fn new(x0: usize, y0: usize, x1: usize, y1: usize, layer_idx: usize) -> Self {
-        Self {
-            x0,
-            y0,
-            x1,
