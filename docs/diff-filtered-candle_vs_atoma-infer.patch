-    let mut dws = Vec::with_capacity(heads);
-    let mut qkvs = Vec::with_capacity(heads);
-    for i in 0..heads {
-        dws.push(depthwise_conv(
-            key_dim,
-            cfg.kernels[i],
-            1,
-            cfg.kernels[i] / 2,
-            vb.pp(format!("dws.{i}")),
-        )?);
-
-        qkvs.push(pointwise_conv(
-            in_channels / heads,
-            in_channels / heads + 2 * key_dim,
-            vb.pp(format!("qkvs.{i}")),
-        )?);
