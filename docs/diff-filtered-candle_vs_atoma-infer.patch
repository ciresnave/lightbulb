-                .map(|bs| match bs {
-                    [a, b] => i16::from_le_bytes([*a, *b]),
-                    _ => unreachable!(),
-                })
-                .map(|i| i as f32 / i16::MAX as f32)
-                .collect();
-            self.len = 0;
-            Some(Ok(buf))
-        } else {
-            self.next()
-        }
-    }
-}
