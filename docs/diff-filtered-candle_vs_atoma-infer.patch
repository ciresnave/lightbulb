-    let ws = ws.reshape((target_in, target_out))?;
-    let bound = 1. / (target_out as f64).sqrt();
-    let init_bs = candle_nn::Init::Uniform {
-        lo: -bound,
-        up: bound,
-    };
-    let bs = vs.get_with_hints(target_in, "bias", init_bs)?;
-    Ok(candle_nn::Linear::new(ws, Some(bs)))
-}
