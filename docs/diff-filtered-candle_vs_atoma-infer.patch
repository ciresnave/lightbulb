-impl SplitResidualVectorQuantizer {
-    pub fn new(
-        dim: usize,
-        input_dim: Option<usize>,
-        output_dim: Option<usize>,
-        n_q: usize,
-        bins: usize,
-        vb: VarBuilder,
-    ) -> Result<Self> {
