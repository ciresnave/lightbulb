-            if shape.elem_count() == 0 {
-                return Ok(self.clone());
-            }
-            let storage = self
-                .storage()
-                .unary_impl::<crate::op::$op_name>(self.layout())?;
-            let op = BackpropOp::new1(self, |s| Op::Unary(s, UnaryOp::$op_name));
