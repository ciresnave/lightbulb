-        })
-    }
-
-    pub fn forward(&self, xs: &Tensor, temb: Option<&Tensor>) -> Result<Tensor> {
-        let _enter = self.span.enter();
-        let shortcut_xs = match &self.conv_shortcut {
-            Some(conv_shortcut) => conv_shortcut.forward(xs)?,
-            None => xs.clone(),
-        };
