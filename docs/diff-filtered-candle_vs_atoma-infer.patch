-    let conv = conv2d_no_bias(in_channels, out_channels, kernel, conv2d_cfg, vb.pp("conv"))?;
-    let conv = conv.absorb_bn(&bn)?;
-    Ok(Func::new(move |xs| {
-        let xs = xs.apply(&conv)?;
-        Ok(xs)
-    }))
-}
