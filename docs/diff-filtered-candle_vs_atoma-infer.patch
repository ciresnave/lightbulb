-                // Add non-overlapping part of current chunk
-                outputs.push(output.i((.., overlap_frames.., ..))?);
-            } else {
-                outputs.push(output);
-            }
-        }
-
-        // Concatenate all outputs
-        let outputs_ref: Vec<&Tensor> = outputs.iter().collect();
-        Tensor::cat(&outputs_ref, 1)
-    }
