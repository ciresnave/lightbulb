/target

# Demo secrets - NEVER COMMIT
.demo-secrets.env
.env
*.env.local
*.key
*.pem

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build artifacts
*.profraw
build_output.txt
temp_candle_ext/

# rustc crash dumps (see the -j 4 build race; dumps are evidence, not artifacts to commit)
rustc-ice-*.txt

# Local tooling scratch — not part of the crate.
# Gitignored rather than left untracked so `git status` can be EMPTY: a status
# that always has one line is a status nobody reads, and an unread status is
# how uncommitted work survives on one disk.
supertool

# Python bytecode. The repo ships scripts/clippy_gate.py, and anything that
# IMPORTS it rather than running it -- a test of its verdict logic, for instance --
# leaves scripts/__pycache__/ behind as untracked noise.
__pycache__/
*.pyc
